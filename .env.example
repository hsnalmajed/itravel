# === Amadeus for Developers (flights + hotels) ===
# Sign up free at https://developers.amadeus.com/register
# Create an app in "My Self-Service Workspace" to get these keys.
# Without these, the site automatically falls back to realistic demo data.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# "test" = free sandbox data (default). "production" = live data, paid after free quota.
AMADEUS_ENV=test

# === AI itinerary generation (Claude / Anthropic API) ===
# Get a key at https://console.anthropic.com/
# Without this, the site falls back to a template-based sample itinerary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Affiliate IDs (optional, for revenue once approved) ===
# Booking.com Affiliate Partner Program: https://www.booking.com/affiliate-program/v2/index.html
BOOKING_AFFILIATE_ID=
# Almosafer partner program (contact Almosafer/Seera Group business development)
ALMOSAFER_AFFILIATE_ID=
