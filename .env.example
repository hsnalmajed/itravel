# ===========================================================================
#  Sfrtna — credentials
#
#  Nothing here is committed with a value in it. On Cloudflare each of these
#  is a secret you set yourself:
#
#      npx wrangler secret put TRAVELPAYOUTS_TOKEN
#
#  Public affiliate ids (the Travelpayouts marker, the Booking.com aid) are
#  NOT set here. They are printed in every outgoing link, so they are not
#  secrets — and a NEXT_PUBLIC_* value only reaches the browser if it exists
#  at *build* time, which a `wrangler secret` does not. They are committed as
#  constants in the code instead (see src/lib/providers/travelpayouts.ts).
# ===========================================================================

# === Travelpayouts — flight prices AND the commission that pays for them ===
# Register (self-service, instant, free): https://www.travelpayouts.com/
# Then: the API token goes into Cloudflare as a secret (never into this repo).
# The affiliate marker (a short number) is public — it goes into the code.
#
# Why this and not a booking API: Duffel, Amadeus, Hotelbeds and the rest
# earn when a reservation completes through them, and price per booking plus
# per search. Sfrtna never takes a booking, so those APIs are pure cost.
# Travelpayouts pays for the *referral*, which is this site's actual model.
#
# Limitation, stated plainly: the free tier returns prices observed over the
# past few days, not live quotes. Travelpayouts gates live search behind
# 50,000 monthly active users. Until then every fare from this source is
# marked as an observed price on the page, never presented as bookable.
#
# Docs: https://travelpayouts-data-api.readthedocs.io/
TRAVELPAYOUTS_TOKEN=

# === AI itinerary generation (Claude / Anthropic API) ===
# Get a key at https://platform.claude.com/ (Settings -> API Keys).
# Without this, the site falls back to a template-based sample itinerary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Viator — tours, tickets and activities ===
# Free, instant, self-service. Basic API access is granted the moment the
# account exists: https://partnerresources.viator.com/
# 8% of completed bookings, 30-day cookie, PayPal weekly with no minimum.
VIATOR_API_KEY=

# === Affiliate ids (public tags — they earn the commission) ===
# Booking.com affiliate: https://www.booking.com/affiliate-program/v2/index.html
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
# Almosafer, via DCMnetwork: https://www.dcmnetwork.com/travel-affiliate-programs/
NEXT_PUBLIC_ALMOSAFER_AFFILIATE_ID=

# === The site's own identity ===
# Without a real domain the sitemap and the SEO tags point at workers.dev.
NEXT_PUBLIC_SITE_URL=
# Until this is set, the contact page says contact isn't open yet rather than
# publishing a personal address.
NEXT_PUBLIC_CONTACT_EMAIL=
